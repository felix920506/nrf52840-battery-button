mainmenu "Battery powered switch"

menu "Battery switch application"

choice APP_TRANSPORT
	prompt "Radio transport"
	default APP_TRANSPORT_MATTER
	help
	  Selects the protocol used to report switch events and battery state.
	  The switch/battery core in src/core does not depend on the transport;
	  a new transport only has to implement src/transport/transport.h.

config APP_TRANSPORT_MATTER
	bool "Matter over Thread"
	help
	  Requires SB_CONFIG_MATTER=y in sysbuild.conf. Every switch is exposed
	  as a Generic Switch endpoint (1..6), the battery as a Power Source
	  cluster on endpoint 0.

config APP_TRANSPORT_BLE
	bool "Bluetooth LE (GATT)"
	select BT
	select BT_PERIPHERAL
	select BT_BAS
	select REBOOT
	help
	  Connectable peripheral that notifies switch events over a custom
	  GATT service, battery level over the Battery Service. Mainly for
	  testing without a Thread network; see src/transport/ble/ and
	  tools/ble_test_client.py. Build with -DFILE_SUFFIX=ble.

endchoice

config APP_BLE_ADV_INTERVAL_MS
	int "BLE advertising interval [ms]"
	depends on APP_TRANSPORT_BLE
	default 1000
	range 20 10000

menu "Switch inputs"

config APP_DEBOUNCE_MS
	int "Momentary switch: debounce time [ms]"
	default 20
	range 1 200

config APP_DEBOUNCE_LATCHING_MS
	int "Latching switch: debounce time [ms]"
	default 20
	range 1 500
	help
	  Debounce time for both latching switch types. Latching-as-press
	  switches report every bounce that outlasts the debounce time as an
	  extra press, so noisy contacts may need more than momentary
	  switches. Nobody flips a switch twice within 100 ms, so values up to
	  that cost no responsiveness.

config APP_LONG_PRESS_MS
	int "Momentary switch: hold time for a long press [ms]"
	default 1000
	range 200 10000

config APP_MULTI_PRESS_WINDOW_MS
	int "Momentary switch: max. gap between presses of a multi-press [ms]"
	default 400
	range 100 2000
	help
	  After the last release, MultiPressComplete is reported once no new
	  press started within this window. Larger values make double presses
	  easier, but delay the single press report by the same amount.

config APP_MULTI_PRESS_MAX
	int "Momentary switch: maximum number of presses in a multi-press"
	default 2
	range 2 10

config APP_LATCH_POLL_INTERVAL_MS
	int "Latching switch: poll interval while the switch is closed [ms]"
	default 100
	range 10 2000
	help
	  A closed switch would permanently draw current through the pull-up
	  resistor (~230 uA at 3 V with the internal 13 kOhm pull-up). While a
	  latching switch (either latching type) is closed, its pin is
	  disconnected and only briefly sampled at this interval. This is the
	  worst case latency for detecting the switch being opened.

config APP_LATCH_POLL_SETTLE_US
	int "Latching switch: pull-up settle time before sampling [us]"
	default 10
	range 1 1000
	help
	  Increase for long cables between the board and the switch.

endmenu

menu "Battery"

choice APP_BATTERY_TYPE
	prompt "Battery type"
	default APP_BATTERY_2XAAA_ALKALINE
	help
	  Selects the voltage-to-charge curve used for the reported battery
	  percentage. The battery is expected to be connected to the 3V3 pin
	  (the nRF52840 supply), so no voltage divider is needed.

config APP_BATTERY_CR2032
	bool "CR2032 lithium coin cell (3 V)"

config APP_BATTERY_2XAAA_ALKALINE
	bool "2x AAA alkaline in series"

config APP_BATTERY_2XAAA_CARBON_ZINC
	bool "2x AAA carbon-zinc in series"

config APP_BATTERY_2XAAA_NIMH
	bool "2x AAA NiMH in series"

endchoice

config APP_BATTERY_MEASURE_INTERVAL_S
	int "Battery measurement interval [s]"
	default 3600
	range 60 86400

config APP_BATTERY_WARNING_PERCENT
	int "Report charge level 'Warning' at or below [%]"
	default 20
	range 0 100

config APP_BATTERY_CRITICAL_PERCENT
	int "Report charge level 'Critical' (replace battery) at or below [%]"
	default 5
	range 0 100

endmenu

menu "User interface"

config APP_STATUS_LED
	bool "Status LED"
	default y
	help
	  Uses the devicetree alias 'status-led' for pairing, identify and
	  factory reset feedback. Blinks are short to save power.

config APP_FACTORY_RESET_HOLD_MS
	int "Reset pad: hold time for factory reset [ms]"
	default 5000
	range 1000 60000
	help
	  The factory reset pad (devicetree: `factory-reset-gpios` in the
	  `zephyr,user` node) has to be held to GND continuously for this
	  long. The pad is separate from the switch inputs, so no switch
	  gesture can trigger a reset.

endmenu

config APP_USB_BOOTLOADER_RESET
	bool "Reboot into the bootloader on a 1200 baud USB touch"
	depends on USB_DEVICE_STACK_NEXT && UART_LINE_CTRL
	help
	  Development helper for builds with the USB console
	  (usb-logging.conf). Opening and closing the USB serial port at
	  1200 baud reboots into the Adafruit bootloader, so the board can be
	  reflashed without pressing reset.

choice APP_USB_BOOTLOADER_MODE
	prompt "Bootloader mode entered on a 1200 baud touch"
	depends on APP_USB_BOOTLOADER_RESET
	default APP_USB_BOOTLOADER_MODE_SERIAL

config APP_USB_BOOTLOADER_MODE_SERIAL
	bool "Serial DFU only"
	help
	  For adafruit-nrfutil, which sends the touch itself:
	    adafruit-nrfutil dfu serial --touch 1200 --singlebank ...
	  More reliable than the USB drive on macOS, which can hang when
	  copying large UF2 files.

config APP_USB_BOOTLOADER_MODE_UF2
	bool "UF2 USB drive"

endchoice

config APP_EVENT_QUEUE_SIZE
	int "Application event queue size"
	default 16

endmenu

# Matter over Thread defaults (same pattern as the nRF Connect SDK Matter
# samples). They only take effect when CONFIG_CHIP is enabled.

# Sleepy end device: the radio is off except for polling the parent.
choice OPENTHREAD_NORDIC_LIBRARY_CONFIGURATION
	default OPENTHREAD_NORDIC_LIBRARY_MTD
endchoice

choice OPENTHREAD_DEVICE_TYPE
	default OPENTHREAD_MTD
endchoice

config CHIP_ENABLE_ICD_SUPPORT
	default y

config CHIP_ICD_LIT_SUPPORT
	default y

config CHIP_ICD_SIT_SLOW_POLL_LIMIT
	default 5000

config CHIP_ICD_REPORT_ON_ACTIVE_MODE
	default y

# 0 dBm is plenty for an end device next to its parent and keeps the TX peak
# current low, which matters for coin cells.
config OPENTHREAD_DEFAULT_TX_POWER
	default 0

source "$(ZEPHYR_CONNECTEDHOMEIP_MODULE_DIR)/config/nrfconnect/chip-module/Kconfig.features"
source "$(ZEPHYR_CONNECTEDHOMEIP_MODULE_DIR)/config/nrfconnect/chip-module/Kconfig.defaults"
source "$(ZEPHYR_NRF_MODULE_DIR)/samples/matter/common/src/Kconfig"

source "Kconfig.zephyr"
